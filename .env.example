# kb-ontology configuration
# Copy to .env and fill in secrets. .env is gitignored.

# ── Krill / grok-4.5 (default for this project) ──────────────────────
AGENT_KB_LLM_ENDPOINT=https://api.cdn-krill-ai.com/v1
AGENT_KB_LLM_MODEL=grok-4.5
AGENT_KB_LLM_API_KEY=  # paste krill API key (nb_…)
AGENT_KB_LLM_API_FORMAT=openai
AGENT_KB_LLM_TIMEOUT=120

# ── Alternatives (uncomment to switch) ───────────────────────────────
# Anthropic-compatible local / 讯飞 proxy:
# AGENT_KB_LLM_ENDPOINT=http://127.0.0.1:3000
# AGENT_KB_LLM_MODEL=xf-glm-5.1
# AGENT_KB_LLM_API_KEY=sk-…
# AGENT_KB_LLM_API_FORMAT=anthropic

# ── Secure HTTP API ──────────────────────────────────────────────────
# JSON object: raw_api_key → {principal_id, tenant_id, roles[]}
# Roles: reader | contributor | admin  (keys must be ≥16 chars)
# KB_ONTOLOGY_API_KEYS={"development-admin-key-0001":{"principal_id":"admin","tenant_id":"default","roles":["admin"]}}
# AGENT_KB_API_KEYS=  # legacy alias, also accepted

# ── Optional OTLP ────────────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=kb-ontology
