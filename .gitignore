.mypy_cache/
.pytest_cache/
.ruff_cache/
.pytest-tmp/

# Python packaging
dist/
build/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
.venv-paddle/

# Database files (generated by build pipeline)
*.sqlite
*.sqlite3
*.db

# Environment and secrets
.env

# Source document corpus (standards, requirements, Athena team docs)
corpus/

# Archived legacy KB1 pipeline data (large, reference only, not tracked)
archive/legacy-kb1/

# Runtime LLM query-understanding cache (regenerated on demand)
agent_kb_core/data/llm_understanding_cache.json
agent_kb_core/src/data/llm_understanding_cache.json

# Runtime temporary directories
tmp/
output/

# Logs
logs/

# Coverage and test reports (generated locally)
htmlcov/
.coverage
.coverage.*

# Git bundle offline backups (binary, large — never track)
*.bundle

# Scratch / temp output files from ad-hoc sessions
/_*.txt

